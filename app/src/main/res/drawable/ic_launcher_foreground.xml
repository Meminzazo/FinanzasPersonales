    <!-- Wallet Clasp Button -->
    <path
        android:pathData="M71,63m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
        android:fillColor="#FBBF24" />

    <!-- Growth Trend Line Curve -->
    <path
        android:pathData="M30,46 C 42,43 50,33 66,25"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Trend Arrowhead -->
    <path
        android:pathData="M59,25 L 67,25 L 67,33"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Golden Coin Outer Circle -->
    <path android:pathData="M68,36m-9,0a9,9 0 1,1 18,0a9,9 0 1,1 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="68"
                android:centerY="32"
                android:gradientRadius="10"
                android:type="radial">
                <item android:offset="0.0" android:color="#FDE047" />
                <item android:offset="0.7" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coin Inner Rim -->
    <path
        android:pathData="M68,36m-7.2,0a7.2,7.2 0 1,1 14.4,0a7.2,7.2 0 1,1 -14.4,0"
        android:strokeWidth="0.8"
        android:strokeColor="#B45309"
        android:fillColor="#00000000" />

    <!-- Currency Symbol ($) inside Coin -->
    <!-- Vertical Line -->
    <path
        android:pathData="M68,31.5 V40.5"
        android:strokeWidth="1.3"
        android:strokeColor="#78350F"
        android:strokeLineCap="round" />

