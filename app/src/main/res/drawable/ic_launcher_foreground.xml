    <path
        android:pathData="M70.5,33.2 C69.8,32.2 66.2,32.2 66.2,34.5 C66.2,36.5 69.8,36.5 69.8,38.5 C69.8,40.5 66.2,40.5 65.5,39.2"
        android:strokeWidth="1.3"
        android:strokeColor="#78350F"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

</vector>
