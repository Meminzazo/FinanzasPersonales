    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Shadow behind Wallet -->
    <path
        android:pathData="M32,51 h44 a6,6 0 0 1 6,6 v20 a6,6 0 0 1 -6,6 h-44 a6,6 0 0 1 -6,-6 v-20 a6,6 0 0 1 6,-6 z"
        android:fillColor="#33000000" />

    <!-- Bar Graph 1 (Left - Shortest) -->
    <path android:pathData="M36,52 V41 a3,3 0 0 1 6,0 V52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="38"
                android:endX="39"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#A7F3D0" />
                <item android:offset="1.0" android:color="#34D399" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar Graph 2 (Middle - Medium) -->
    <path android:pathData="M45,52 V34 a3,3 0 0 1 6,0 V52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="31"
                android:endX="48"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#6EE7B7" />
                <item android:offset="1.0" android:color="#10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar Graph 3 (Right - Tallest) -->
    <path android:pathData="M54,52 V27 a3,3 0 0 1 6,0 V52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="57"
                android:startY="24"
                android:endX="57"
                android:endY="52"
                android:type="linear">
                <item android:offset="0.0" android:color="#34D399" />
                <item android:offset="1.0" android:color="#059669" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Wallet / Card Body -->
    <path android:pathData="M32,48 h44 a6,6 0 0 1 6,6 v20 a6,6 0 0 1 -6,6 h-44 a6,6 0 0 1 -6,-6 v-20 a6,6 0 0 1 6,-6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="48"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="0.6" android:color="#059669" />
                <item android:offset="1.0" android:color="#047857" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Wallet Front Card Slot / Pocket Line -->
    <path
        android:pathData="M26,57 h56"
        android:strokeWidth="1.8"
        android:strokeColor="#A7F3D0" />

    <!-- Wallet Clasp Strap -->
    <path
        android:pathData="M65,58 h11 a2,2 0 0 1 2,2 v6 a2,2 0 0 1 -2,2 h-11 a2,2 0 0 1 -2,-2 v-6 a2,2 0 0 1 2,-2 z"
